<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>Dashboard</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- The dashboard formats numbers and times itself, so it does not download the ICU data. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The deployment replaces topology.json and runtime/: no precompressed copy (.br, .gz) may outlive the sample. -->
    <CompressionExcludePatterns>$(CompressionExcludePatterns);topology.json;runtime/**</CompressionExcludePatterns>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

</Project>
