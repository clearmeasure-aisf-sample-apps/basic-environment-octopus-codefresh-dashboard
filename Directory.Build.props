<Project>

  <!-- Applies to every project of the solution. Warnings are errors: a build that warns does not pass. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The build passes -p:Version=MAJOR.MINOR.run; a local build is marked as such in the footer. -->
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
  </PropertyGroup>

</Project>
